{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Dynamic storefront product category managed by Admin",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "minLength": 1, "maxLength": 64 },
        "nameKm": { "type": "string", "minLength": 1, "maxLength": 80 },
        "nameEn": { "type": "string", "maxLength": 80 },
        "sortOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["slug", "nameKm", "sortOrder"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount code",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 2, "maxLength": 32 },
        "discountType": { "type": "string", "enum": ["percent", "fixed"] },
        "discountValue": { "type": "number" },
        "minOrderUsd": { "type": "number" },
        "maxUses": { "type": "integer" },
        "usedCount": { "type": "integer" },
        "active": { "type": "boolean" },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "discountType", "discountValue", "active"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Shop storefront configuration, ABA bank info, Store KHQR images, delivery fees, and contact info",
      "type": "object",
      "properties": {
        "shopName": { "type": "string", "maxLength": 100 },
        "heroEyebrow": { "type": "string", "maxLength": 140 },
        "heroTitle": { "type": "string", "maxLength": 200 },
        "heroSubtitle": { "type": "string", "maxLength": 400 },
        "announcementText": { "type": "string", "maxLength": 240 },
        "contactPhone": { "type": "string", "maxLength": 60 },
        "contactAddress": { "type": "string", "maxLength": 200 },
        "contactLat": { "type": "number" },
        "contactLng": { "type": "number" },
        "contactMapUrl": { "type": "string", "maxLength": 400 },
        "contactMapImageUrl": { "type": "string", "maxLength": 350000 },
        "telegramContact": { "type": "string", "maxLength": 80 },
        "abaAccountName": { "type": "string", "maxLength": 100 },
        "abaAccountId": { "type": "string", "maxLength": 40 },
        "abaAccountUsd": { "type": "string", "maxLength": 40 },
        "abaAccountKhr": { "type": "string", "maxLength": 40 },
        "abaQrUsdImage": { "type": "string", "maxLength": 350000 },
        "abaQrKhrImage": { "type": "string", "maxLength": 350000 },
        "khrRate": { "type": "integer" },
        "freeShippingThresholdUsd": { "type": "number" },
        "phnomPenhShippingUsd": { "type": "number" },
        "provinceShippingUsd": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shopName", "khrRate", "freeShippingThresholdUsd"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog product sold in Oudom Shop",
      "type": "object",
      "properties": {
        "sku": { "type": "string", "minLength": 2, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "priceUsd": { "type": "number" },
        "discountPriceUsd": { "type": "number" },
        "stock": { "type": "integer" },
        "status": {
          "type": "string",
          "enum": ["available", "out_of_stock"]
        },
        "description": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 350000 },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "isNew": { "type": "boolean" },
        "isPopular": { "type": "boolean" },
        "soldCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sku", "name", "category", "priceUsd", "stock", "status", "imageUrl"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "minLength": 4, "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customerPhone": { "type": "string", "minLength": 6, "maxLength": 32 },
        "shippingAddress": { "type": "string", "minLength": 3, "maxLength": 400 },
        "locationLat": { "type": "number" },
        "locationLng": { "type": "number" },
        "locationMapUrl": { "type": "string", "maxLength": 400 },
        "locationImageUrl": { "type": "string", "maxLength": 350000 },
        "deliveryZone": { "type": "string", "enum": ["phnom_penh", "province"] },
        "notes": { "type": "string", "maxLength": 500 },
        "items": { "type": "array" },
        "subtotalUsd": { "type": "number" },
        "shippingFeeUsd": { "type": "number" },
        "discountUsd": { "type": "number" },
        "couponCode": { "type": "string", "maxLength": 32 },
        "couponDiscountUsd": { "type": "number" },
        "totalUsd": { "type": "number" },
        "totalKhr": { "type": "integer" },
        "currency": { "type": "string", "enum": ["USD", "KHR"] },
        "paymentMethod": { "type": "string", "enum": ["bank_qr", "cod", "aba_payway", "aba_khqr"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed"] },
        "orderStatus": {
          "type": "string",
          "enum": ["pending", "paid", "processing", "shipping", "completed", "cancelled", "failed"]
        },
        "abaTranId": { "type": "string", "maxLength": 64 },
        "abaMode": { "type": "string", "enum": ["live", "direct_qr", "cod", "unconfigured"] },
        "paymentSlipUrl": { "type": "string", "maxLength": 350000 },
        "paymentReference": { "type": "string", "maxLength": 120 },
        "paymentSubmittedAt": { "type": "string", "format": "date-time" },
        "receiptConfirmed": { "type": "boolean" },
        "receiptConfirmedAt": { "type": "string", "format": "date-time" },
        "telegramNotified": { "type": "boolean" },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderNumber",
        "customerName",
        "customerPhone",
        "shippingAddress",
        "totalUsd",
        "paymentMethod",
        "paymentStatus",
        "orderStatus"
      ]
    },
    "OrderTracking": {
      "title": "OrderTracking",
      "description": "Zero-PII order status snapshot keyed by SHA-256 hash of orderNumber and phone",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "minLength": 4, "maxLength": 64 },
        "paymentMethod": { "type": "string", "enum": ["bank_qr", "cod", "aba_payway", "aba_khqr"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed"] },
        "orderStatus": {
          "type": "string",
          "enum": ["pending", "paid", "processing", "shipping", "completed", "cancelled", "failed"]
        },
        "totalUsd": { "type": "number" },
        "totalKhr": { "type": "integer" },
        "currency": { "type": "string", "enum": ["USD", "KHR"] },
        "items": { "type": "array" },
        "paymentSubmittedAt": { "type": "string", "maxLength": 64 },
        "receiptConfirmed": { "type": "boolean" },
        "receiptConfirmedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "orderNumber", "paymentMethod", "paymentStatus", "orderStatus", "totalUsd", "totalKhr"]
    },
    "PaymentProof": {
      "title": "PaymentProof",
      "description": "Customer submitted payment slip and bank reference verified by trackingKey",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "trackingKey": { "type": "string", "minLength": 64, "maxLength": 64 },
        "reference": { "type": "string", "maxLength": 120 },
        "slipUrl": { "type": "string", "maxLength": 350000 },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "orderNumber", "trackingKey", "submittedAt"]
    },
    "ReceiptConfirmation": {
      "title": "ReceiptConfirmation",
      "description": "Customer-only delivery receipt confirmation keyed by SHA-256(orderNumber:phone)",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "confirmedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "orderNumber", "confirmedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Persisted customer profile and order aggregates",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 6, "maxLength": 32 },
        "address": { "type": "string", "maxLength": 400 },
        "totalOrders": { "type": "integer" },
        "totalSpentUsd": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "totalOrders", "totalSpentUsd"]
    },
    "PaymentLog": {
      "title": "PaymentLog",
      "description": "Payment verification history",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 128 },
        "tranId": { "type": "string", "maxLength": 64 },
        "amountUsd": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD", "KHR"] },
        "status": { "type": "string", "enum": ["pending", "paid", "failed"] },
        "provider": { "type": "string", "maxLength": 64 },
        "verifiedByServer": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "tranId", "amountUsd", "status", "verifiedByServer"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Authorized admin role mapping by Firebase UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "enum": ["super_admin", "manager", "staff"] },
        "active": { "type": "boolean" }
      },
      "required": ["uid", "email", "role", "active"]
    },
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "Server-only hashed admin accounts",
      "type": "object",
      "properties": {
        "username": { "type": "string", "minLength": 3, "maxLength": 64 },
        "role": { "type": "string", "enum": ["super_admin", "manager", "staff"] },
        "active": { "type": "boolean" }
      },
      "required": ["username", "role", "active"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Optimized uploaded product media stored permanently",
      "type": "object",
      "properties": {
        "mimeType": { "type": "string", "maxLength": 64 },
        "sizeBytes": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["mimeType", "sizeBytes"]
    },
    "DatabaseBackup": {
      "title": "DatabaseBackup",
      "description": "Database snapshot metadata for backup & restore",
      "type": "object",
      "properties": {
        "createdBy": { "type": "string", "maxLength": 128 },
        "productCount": { "type": "integer" },
        "orderCount": { "type": "integer" },
        "customerCount": { "type": "integer" },
        "paymentCount": { "type": "integer" },
        "trigger": { "type": "string", "enum": ["manual", "auto_scheduled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["createdBy", "productCount", "orderCount"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Dynamic product categories managed by Admin"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional discount coupons managed by Admin; exact code lookup by customers"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Storefront configuration, shipping rules, and KHQR images"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public storefront product catalog; writable only by verified admins"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders containing PII; creatable at checkout, readable/updatable only by admin or verified owner"
    },
    "/order_tracking/{trackingKey}": {
      "schema": { "$ref": "#/entities/OrderTracking" },
      "description": "Zero-PII order status lookup keyed by SHA-256 hash of orderNumber and phone"
    },
    "/payment_proofs/{proofId}": {
      "schema": { "$ref": "#/entities/PaymentProof" },
      "description": "Customer submitted payment slip and reference; creatable only with valid trackingKey, readable/updatable only by admin"
    },
    "/receipt_confirmations/{trackingKey}": {
      "schema": { "$ref": "#/entities/ReceiptConfirmation" },
      "description": "Customer-only delivery receipt confirmation keyed by SHA-256(orderNumber:phone)"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer directory with PII; admin-only access"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentLog" },
      "description": "Payment verification records; admin-only access"
    },
    "/admin_roles/{uid}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Firebase Auth admin role directory"
    },
    "/admin_accounts/{accountId}": {
      "schema": { "$ref": "#/entities/AdminAccount" },
      "description": "Server-only hashed admin accounts"
    },
    "/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Uploaded product images"
    },
    "/backups/{backupId}": {
      "schema": { "$ref": "#/entities/DatabaseBackup" },
      "description": "Database backup records"
    }
  }
}
