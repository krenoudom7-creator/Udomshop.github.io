# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Admin Authentication & Security (Server-side only — NEVER expose to frontend)
ADMIN_USERNAME="oudom_admin"
ADMIN_PASSWORD="ChangeMeStrongPassword!"
ADMIN_ACCESS_CODE="OUDOM-2026-SEC"
SESSION_SECRET="replace-with-strong-random-64-char-secret"
SUPER_ADMIN_EMAIL="krenoudom7@gmail.com"

# ABA PayWay Official Merchant API Credentials
ABA_PAYWAY_MERCHANT_ID="YOUR_ABA_MERCHANT_ID"
ABA_PAYWAY_API_KEY="YOUR_ABA_RSA_OR_HMAC_API_KEY"
ABA_PAYWAY_API_URL="https://checkout.payway.com.kh/api/payment-gateway/v1/payments/purchase"
ABA_PAYWAY_CHECK_URL="https://checkout.payway.com.kh/api/payment-gateway/v1/payments/check-transaction-2"

# Telegram Bot Notification Credentials (Server-side only)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_ADMIN_TELEGRAM_CHAT_ID"

# Currency Conversion Rate (1 USD to KHR)
KHR_EXCHANGE_RATE="4100"
